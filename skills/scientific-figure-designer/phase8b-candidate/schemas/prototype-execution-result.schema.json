{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "prototype-execution-result.schema.json", "type": "object",
  "required": ["schema_name", "schema_version", "execution_result_id", "execution_result_sha256", "execution_id", "execution_manifest_sha256", "execution_package_hash", "authorization_ref", "program_sha256", "backend_profile_sha256", "command", "status", "exit_code", "started_at", "finished_at", "inputs_before", "inputs_after", "outputs", "stdout", "stderr", "issues"],
  "properties": {
    "schema_name": {"const": "prototype_execution_result"}, "schema_version": {"const": "0.1.0"},
    "execution_result_id": {"type": "string", "minLength": 1}, "execution_result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_id": {"type": "string", "minLength": 1}, "execution_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "execution_package_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorization_ref": {"$ref": "#/$defs/hashRef"}, "program_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "backend_profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "command": {"type": "array", "minItems": 3, "items": {"type": "string"}}, "status": {"type": "string", "enum": ["succeeded", "failed", "blocked", "not_run"]}, "exit_code": {"type": "integer", "minimum": 0},
    "started_at": {"type": "string", "format": "date-time"}, "finished_at": {"type": "string", "format": "date-time"},
    "inputs_before": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/inputHash"}}, "inputs_after": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/inputHash"}},
    "outputs": {"type": "array", "items": {"type": "object", "required": ["role", "path", "format", "size", "sha256", "panel_ids"], "properties": {"role": {"type": "string"}, "path": {"type": "string", "minLength": 1}, "format": {"type": "string", "enum": ["svg", "png", "tsv", "json"]}, "size": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "panel_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}}, "additionalProperties": false}},
    "stdout": {"$ref": "#/$defs/fileHash"}, "stderr": {"$ref": "#/$defs/fileHash"},
    "issues": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "hashRef": {"type": "object", "required": ["id", "version", "sha256"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false},
    "inputHash": {"type": "object", "required": ["input_id", "sha256"], "properties": {"input_id": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false},
    "fileHash": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
