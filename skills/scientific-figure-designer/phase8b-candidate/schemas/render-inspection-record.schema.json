{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "render-inspection-record.schema.json", "type": "object",
  "required": ["schema_name", "schema_version", "inspection_id", "inspection_sha256", "render_manifest_ref", "inspector_class", "inspector_identity", "tool_versions", "inspected_at", "occurrence_evidence", "inspected_outputs", "assessed_domains", "unassessed_domains", "findings", "no_authority", "provenance_limitations"],
  "properties": {
    "schema_name": {"const": "render_inspection_record"}, "schema_version": {"const": "0.1.0"}, "inspection_id": {"type": "string", "minLength": 1}, "inspection_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "render_manifest_ref": {"$ref": "#/$defs/hashRef"},
    "inspector_class": {"type": "string", "enum": ["deterministic_tool", "model", "human"]}, "inspector_identity": {"type": "string", "minLength": 1}, "tool_versions": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "inspected_at": {"type": "string", "format": "date-time"},
    "occurrence_evidence": {"type": "string", "enum": ["record_only_not_proof", "orchestration_declared_not_receipted", "human_attestation"]},
    "inspected_outputs": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["role", "path", "sha256", "visible_evidence_locators"], "properties": {"role": {"type": "string"}, "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "visible_evidence_locators": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}},
    "assessed_domains": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}, "unassessed_domains": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "findings": {"type": "array", "items": {"type": "object", "required": ["finding_id", "severity", "domain", "message", "route"], "properties": {"finding_id": {"type": "string", "minLength": 1}, "severity": {"type": "string", "enum": ["info", "warning", "blocker"]}, "domain": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}, "route": {"type": "string", "enum": ["realization_correction", "design_review", "author_review"]}}, "additionalProperties": false}},
    "no_authority": {"const": true}, "provenance_limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "$defs": {"hashRef": {"type": "object", "required": ["id", "version", "sha256"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false}},
  "additionalProperties": false
}
