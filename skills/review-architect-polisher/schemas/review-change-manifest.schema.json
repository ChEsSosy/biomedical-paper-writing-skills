{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-change-manifest.schema.json",
  "title": "Phase 7B Review Change Manifest 0.1.0",
  "type": "object", "additionalProperties": false,
  "required": ["schema_name", "schema_version", "artifact_id", "artifact_sha256", "source_artifact", "candidate_artifact", "permission_ref", "proposal_ref", "lineage_ref", "protected_inventory_ref", "author_query_list_ref", "application_receipt_ref", "revision_mode", "upstream_closure_refs", "changes", "protected_change_ids", "citation_support_warnings", "producer_state", "author_review_required", "module06_handoff", "scientific_correctness_claimed", "qc_pass_claimed"],
  "properties": {
    "schema_name": {"const": "review_change_manifest"}, "schema_version": {"const": "0.1.0"},
    "artifact_id": {"$ref": "#/$defs/id"}, "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "source_artifact": {"$ref": "#/$defs/documentRef"}, "candidate_artifact": {"$ref": "#/$defs/documentRef"},
    "permission_ref": {"$ref": "#/$defs/permissionRef"}, "proposal_ref": {"$ref": "#/$defs/proposalRef"},
    "lineage_ref": {"$ref": "#/$defs/artifactRef"}, "protected_inventory_ref": {"$ref": "#/$defs/artifactRef"}, "author_query_list_ref": {"$ref": "#/$defs/artifactRef"},
    "application_receipt_ref": {"$ref": "#/$defs/artifactRef"},
    "revision_mode": {"enum": ["light", "medium", "deep"]},
    "upstream_closure_refs": {"$ref": "#/$defs/upstreamClosure"},
    "changes": {"type": "array", "items": {"$ref": "#/$defs/change"}, "uniqueItems": true},
    "protected_change_ids": {"$ref": "#/$defs/idArray"},
    "citation_support_warnings": {"type": "array", "items": {"$ref": "#/$defs/citationWarning"}, "uniqueItems": true},
    "producer_state": {"enum": ["blocked", "author_review_required", "ready_for_independent_qc"]},
    "author_review_required": {"const": true},
    "module06_handoff": {"type": "object", "additionalProperties": false, "required": ["interface_name", "interface_version", "state"], "properties": {"interface_name": {"const": "module06_review_revision_admission"}, "interface_version": {"type": "null"}, "state": {"const": "blocked_pending_module06_integration_contract"}}},
    "scientific_correctness_claimed": {"const": false}, "qc_pass_claimed": {"const": false}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "idArray": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
    "documentRef": {"type": "object", "additionalProperties": false, "required": ["manuscript_id", "artifact_id", "artifact_version", "artifact_sha256"], "properties": {"manuscript_id": {"$ref": "#/$defs/id"}, "artifact_id": {"$ref": "#/$defs/id"}, "artifact_version": {"$ref": "#/$defs/id"}, "artifact_sha256": {"$ref": "#/$defs/sha256"}}},
    "artifactRef": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "artifact_version", "artifact_sha256"], "properties": {"artifact_id": {"$ref": "#/$defs/id"}, "artifact_version": {"$ref": "#/$defs/id"}, "artifact_sha256": {"$ref": "#/$defs/sha256"}}},
    "permissionRef": {"type": "object", "additionalProperties": false, "required": ["permission_id", "permission_version", "permission_sha256"], "properties": {"permission_id": {"$ref": "#/$defs/id"}, "permission_version": {"$ref": "#/$defs/id"}, "permission_sha256": {"$ref": "#/$defs/sha256"}}},
    "proposalRef": {"type": "object", "additionalProperties": false, "required": ["proposal_id", "proposal_version", "proposal_sha256"], "properties": {"proposal_id": {"$ref": "#/$defs/id"}, "proposal_version": {"$ref": "#/$defs/id"}, "proposal_sha256": {"$ref": "#/$defs/sha256"}}},
    "locator": {"type": "object", "additionalProperties": false, "required": ["locator_type", "side", "artifact_id", "unit_id", "span_sha256"], "properties": {"locator_type": {"enum": ["structured_unit", "authorized_empty_draft_slot"]}, "side": {"enum": ["source", "candidate"]}, "artifact_id": {"$ref": "#/$defs/id"}, "unit_id": {"$ref": "#/$defs/id"}, "span_sha256": {"$ref": "#/$defs/sha256"}}},
    "closure": {"type": "object", "additionalProperties": false, "required": ["claim_ids", "citation_relation_ids", "source_ids", "extraction_record_ids", "conflict_ids", "limitation_ids", "gap_ids", "author_position_ids", "future_direction_ids"], "properties": {"claim_ids": {"$ref": "#/$defs/idArray"}, "citation_relation_ids": {"$ref": "#/$defs/idArray"}, "source_ids": {"$ref": "#/$defs/idArray"}, "extraction_record_ids": {"$ref": "#/$defs/idArray"}, "conflict_ids": {"$ref": "#/$defs/idArray"}, "limitation_ids": {"$ref": "#/$defs/idArray"}, "gap_ids": {"$ref": "#/$defs/idArray"}, "author_position_ids": {"$ref": "#/$defs/idArray"}, "future_direction_ids": {"$ref": "#/$defs/idArray"}}},
    "phase7aRefs": {"type": "object", "additionalProperties": false, "required": ["scope", "source_registry", "synthesis_matrix", "outline", "extraction_records", "authority_manifest_sha256"], "properties": {"scope": {"$ref": "#/$defs/artifactRef"}, "source_registry": {"$ref": "#/$defs/artifactRef"}, "synthesis_matrix": {"$ref": "#/$defs/artifactRef"}, "outline": {"$ref": "#/$defs/artifactRef"}, "extraction_records": {"type": "array", "items": {"$ref": "#/$defs/artifactRef"}, "uniqueItems": true}, "authority_manifest_sha256": {"$ref": "#/$defs/sha256"}}},
    "profileRef": {"type": "object", "additionalProperties": false, "required": ["profile_id", "profile_version", "profile_sha256", "document_type", "corpus_type", "review_state", "stale", "feature_id", "support_locator"], "properties": {"profile_id": {"$ref": "#/$defs/id"}, "profile_version": {"$ref": "#/$defs/id"}, "profile_sha256": {"$ref": "#/$defs/sha256"}, "document_type": {"const": "review_article"}, "corpus_type": {"const": "review_only"}, "review_state": {"const": "reviewed"}, "stale": {"const": false}, "feature_id": {"$ref": "#/$defs/id"}, "support_locator": {"$ref": "#/$defs/id"}}},
    "operationClosure": {"type": "object", "additionalProperties": false, "required": ["operation_id", "phase7a_closure"], "properties": {"operation_id": {"$ref": "#/$defs/id"}, "phase7a_closure": {"$ref": "#/$defs/closure"}}},
    "upstreamClosure": {"type": "object", "additionalProperties": false, "required": ["phase7a_artifacts", "operation_closures", "profile_ref"], "properties": {"phase7a_artifacts": {"$ref": "#/$defs/phase7aRefs"}, "operation_closures": {"type": "array", "items": {"$ref": "#/$defs/operationClosure"}, "minItems": 1, "uniqueItems": true}, "profile_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/profileRef"}]}}},
    "citationWarning": {"type": "object", "additionalProperties": false, "required": ["warning_id", "operation_id", "candidate_sentence_id", "citation_token", "citation_identity", "source_ids", "synthesis_relation_id", "extraction_record_ids", "source_locators", "candidate_locator", "access_ceiling", "reason", "author_review_required"], "properties": {"warning_id": {"$ref": "#/$defs/id"}, "operation_id": {"$ref": "#/$defs/id"}, "candidate_sentence_id": {"$ref": "#/$defs/id"}, "citation_token": {"type": "string", "minLength": 1}, "citation_identity": {"type": "string", "minLength": 1}, "source_ids": {"$ref": "#/$defs/idArray"}, "synthesis_relation_id": {"$ref": "#/$defs/id"}, "extraction_record_ids": {"$ref": "#/$defs/idArray"}, "source_locators": {"type": "array", "items": {"$ref": "#/$defs/locator"}}, "candidate_locator": {"$ref": "#/$defs/locator"}, "access_ceiling": {"$ref": "#/$defs/id"}, "reason": {"type": "string", "minLength": 1}, "author_review_required": {"const": true}}},
    "change": {"type": "object", "additionalProperties": false, "required": ["change_id", "operation_id", "operation_type", "inventory_change_id", "source_unit_ids", "candidate_unit_ids", "authorized_draft_slot_ids", "source_locators", "candidate_locators", "source_representation_sha256", "candidate_representation_sha256", "revision_mode", "permission_ref", "permission_authorization_state", "protected_change_ids", "phase7a_closure", "permission_decision_ids", "affected_protected_anchor_ids", "rationale", "risk_class", "observed_effects", "author_review_required"], "properties": {"change_id": {"$ref": "#/$defs/id"}, "operation_id": {"$ref": "#/$defs/id"}, "operation_type": {"enum": ["replace_unit_text", "paragraph_split", "paragraph_merge", "paragraph_move", "section_move", "theme_reorganization", "draft_authorized_unit"]}, "inventory_change_id": {"$ref": "#/$defs/id"}, "source_unit_ids": {"$ref": "#/$defs/idArray"}, "candidate_unit_ids": {"$ref": "#/$defs/idArray"}, "authorized_draft_slot_ids": {"$ref": "#/$defs/idArray"}, "source_locators": {"type": "array", "items": {"$ref": "#/$defs/locator"}}, "candidate_locators": {"type": "array", "items": {"$ref": "#/$defs/locator"}, "minItems": 1}, "source_representation_sha256": {"$ref": "#/$defs/sha256"}, "candidate_representation_sha256": {"$ref": "#/$defs/sha256"}, "revision_mode": {"enum": ["light", "medium", "deep"]}, "permission_ref": {"$ref": "#/$defs/permissionRef"}, "permission_authorization_state": {"enum": ["caller_accepted", "author_approved"]}, "protected_change_ids": {"$ref": "#/$defs/idArray"}, "phase7a_closure": {"$ref": "#/$defs/closure"}, "permission_decision_ids": {"$ref": "#/$defs/idArray"}, "affected_protected_anchor_ids": {"$ref": "#/$defs/idArray"}, "rationale": {"type": "string", "minLength": 1}, "risk_class": {"enum": ["low", "moderate", "high"]}, "observed_effects": {"$ref": "#/$defs/idArray"}, "author_review_required": {"const": true}}}
  }
}
