{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-protected-change-inventory.schema.json",
  "title": "Phase 7B Review Protected Change Inventory 0.1.0",
  "type": "object", "additionalProperties": false,
  "required": ["schema_name", "schema_version", "artifact_id", "artifact_sha256", "source_artifact", "candidate_artifact", "lineage_ref", "structural_footprint", "changed_units", "citation_anchors", "protected_changes"],
  "properties": {
    "schema_name": {"const": "review_protected_change_inventory"}, "schema_version": {"const": "0.1.0"},
    "artifact_id": {"$ref": "#/$defs/id"}, "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "source_artifact": {"$ref": "#/$defs/documentRef"}, "candidate_artifact": {"$ref": "#/$defs/documentRef"}, "lineage_ref": {"$ref": "#/$defs/artifactRef"},
    "structural_footprint": {"$ref": "#/$defs/footprint"},
    "changed_units": {"type": "array", "items": {"$ref": "#/$defs/changedUnit"}, "uniqueItems": true},
    "citation_anchors": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "candidate"],
      "properties": {
        "source": {"type": "array", "items": {"$ref": "#/$defs/citationAnchor"}, "uniqueItems": true},
        "candidate": {"type": "array", "items": {"$ref": "#/$defs/citationAnchor"}, "uniqueItems": true}
      }
    },
    "protected_changes": {"type": "array", "items": {"$ref": "#/$defs/protectedChange"}, "uniqueItems": true}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "idArray": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
    "documentRef": {"type": "object", "additionalProperties": false, "required": ["manuscript_id", "artifact_id", "artifact_version", "artifact_sha256"], "properties": {"manuscript_id": {"$ref": "#/$defs/id"}, "artifact_id": {"$ref": "#/$defs/id"}, "artifact_version": {"$ref": "#/$defs/id"}, "artifact_sha256": {"$ref": "#/$defs/sha256"}}},
    "artifactRef": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "artifact_version", "artifact_sha256"], "properties": {"artifact_id": {"$ref": "#/$defs/id"}, "artifact_version": {"$ref": "#/$defs/id"}, "artifact_sha256": {"$ref": "#/$defs/sha256"}}},
    "locator": {"type": "object", "additionalProperties": false, "required": ["locator_type", "side", "artifact_id", "unit_id", "span_sha256"], "properties": {"locator_type": {"enum": ["structured_unit", "authorized_empty_draft_slot"]}, "side": {"enum": ["source", "candidate"]}, "artifact_id": {"$ref": "#/$defs/id"}, "unit_id": {"$ref": "#/$defs/id"}, "span_sha256": {"$ref": "#/$defs/sha256"}}},
    "citationLocator": {"type": "object", "additionalProperties": false, "required": ["locator_type", "side", "artifact_id", "unit_id", "sentence_id", "start", "end", "span_sha256"], "properties": {"locator_type": {"const": "structured_citation_token"}, "side": {"enum": ["source", "candidate"]}, "artifact_id": {"$ref": "#/$defs/id"}, "unit_id": {"$ref": "#/$defs/id"}, "sentence_id": {"$ref": "#/$defs/id"}, "start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1}, "span_sha256": {"$ref": "#/$defs/sha256"}}},
    "citationAnchor": {"type": "object", "additionalProperties": false, "required": ["citation_anchor_id", "citation_style", "identity", "token", "locator", "claim_ids", "citation_relation_ids"], "properties": {"citation_anchor_id": {"$ref": "#/$defs/id"}, "citation_style": {"enum": ["numeric_bracket", "author_year", "html_superscript", "unicode_superscript", "caret_superscript"]}, "identity": {"type": "string", "minLength": 1}, "token": {"type": "string", "minLength": 1}, "locator": {"$ref": "#/$defs/citationLocator"}, "claim_ids": {"$ref": "#/$defs/idArray"}, "citation_relation_ids": {"$ref": "#/$defs/idArray"}}},
    "footprint": {"type": "object", "additionalProperties": false, "required": ["paragraph_count_changed", "paragraph_order_changed", "sentence_count_changed", "sentence_order_changed", "section_membership_changed", "unit_split", "unit_merge", "unit_move", "unit_added", "authorized_draft_slot_materialized", "citation_placement_changed", "unit_removed"], "properties": {"paragraph_count_changed": {"type": "boolean"}, "paragraph_order_changed": {"type": "boolean"}, "sentence_count_changed": {"type": "boolean"}, "sentence_order_changed": {"type": "boolean"}, "section_membership_changed": {"type": "boolean"}, "unit_split": {"type": "boolean"}, "unit_merge": {"type": "boolean"}, "unit_move": {"type": "boolean"}, "unit_added": {"type": "boolean"}, "authorized_draft_slot_materialized": {"type": "boolean"}, "citation_placement_changed": {"type": "boolean"}, "unit_removed": {"type": "boolean"}}},
    "changedUnit": {"type": "object", "additionalProperties": false, "required": ["inventory_change_id", "source_unit_ids", "authorized_draft_slot_ids", "candidate_unit_ids", "source_representation_sha256", "candidate_representation_sha256", "observed_effects", "source_locators", "candidate_locators", "section_id", "paragraph_plan_id"], "properties": {"inventory_change_id": {"$ref": "#/$defs/id"}, "source_unit_ids": {"$ref": "#/$defs/idArray"}, "authorized_draft_slot_ids": {"$ref": "#/$defs/idArray"}, "candidate_unit_ids": {"$ref": "#/$defs/idArray"}, "source_representation_sha256": {"$ref": "#/$defs/sha256"}, "candidate_representation_sha256": {"$ref": "#/$defs/sha256"}, "observed_effects": {"$ref": "#/$defs/idArray"}, "source_locators": {"type": "array", "items": {"$ref": "#/$defs/locator"}}, "candidate_locators": {"type": "array", "items": {"$ref": "#/$defs/locator"}}, "section_id": {"$ref": "#/$defs/id"}, "paragraph_plan_id": {"$ref": "#/$defs/id"}}},
    "lexicalBoundary": {"type": "object", "additionalProperties": false, "required": ["alignment_status", "left_anchor", "right_anchor"], "properties": {"alignment_status": {"enum": ["aligned", "not_applicable", "ambiguous"]}, "left_anchor": {"type": "string", "minLength": 1}, "right_anchor": {"type": "string", "minLength": 1}}},
    "citationPlacement": {"type": "object", "additionalProperties": false, "required": ["unit_id", "sentence_id", "source_sentence_ids", "section_id", "paragraph_plan_id", "boundary_role", "citation_form", "occurrence_ordinal", "start", "end", "lexical_boundary"], "properties": {"unit_id": {"$ref": "#/$defs/id"}, "sentence_id": {"$ref": "#/$defs/id"}, "source_sentence_ids": {"$ref": "#/$defs/idArray"}, "section_id": {"$ref": "#/$defs/id"}, "paragraph_plan_id": {"$ref": "#/$defs/id"}, "boundary_role": {"enum": ["leading", "medial", "trailing", "isolated"]}, "citation_form": {"enum": ["numeric_bracket", "numeric_superscript", "author_year_parenthetical", "author_year_narrative"]}, "occurrence_ordinal": {"type": "integer", "minimum": 1}, "start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1}, "lexical_boundary": {"$ref": "#/$defs/lexicalBoundary"}}},
    "protectedChange": {"type": "object", "additionalProperties": false, "required": ["protected_change_id", "inventory_change_id", "protected_class", "identity", "delta_type", "occurrence_delta", "authorized_draft_slot_ids"], "properties": {"protected_change_id": {"$ref": "#/$defs/id"}, "inventory_change_id": {"$ref": "#/$defs/id"}, "protected_class": {"enum": ["citation", "numeric", "statistic", "unit", "terminology", "figure_table_reference", "negation", "comparison_direction", "causal_mechanistic", "certainty_hedging", "consensus_conflict"]}, "identity": {"type": "string", "minLength": 1}, "delta_type": {"enum": ["added", "deleted", "relation_added", "relation_deleted", "formatting_only", "placement_changed"]}, "occurrence_delta": {"type": "integer", "minimum": 1}, "source_token": {"type": "string", "minLength": 1}, "candidate_token": {"type": "string", "minLength": 1}, "source_placement": {"$ref": "#/$defs/citationPlacement"}, "candidate_placement": {"$ref": "#/$defs/citationPlacement"}, "authorized_draft_slot_ids": {"$ref": "#/$defs/idArray"}, "claim_ids": {"$ref": "#/$defs/idArray"}, "citation_relation_ids": {"$ref": "#/$defs/idArray"}}}
  }
}
