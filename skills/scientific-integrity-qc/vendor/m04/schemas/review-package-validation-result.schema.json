{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-package-validation-result.schema.json",
  "title": "Phase 7B Review Package Validation Result 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "artifact_id", "artifact_sha256", "source_artifact", "candidate_artifact", "permission_ref", "proposal_ref", "change_manifest_ref", "application_receipt_ref", "validator_engine", "valid", "producer_state", "issue_count", "issues", "author_review_required", "module06_handoff_state"],
  "properties": {
    "schema_name": {"const": "review_package_validation_result"},
    "schema_version": {"const": "0.1.0"},
    "artifact_id": {"$ref": "#/$defs/id"},
    "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "source_artifact": {"$ref": "#/$defs/documentRef"},
    "candidate_artifact": {"$ref": "#/$defs/documentRef"},
    "permission_ref": {"$ref": "#/$defs/permissionRef"},
    "proposal_ref": {"$ref": "#/$defs/proposalRef"},
    "change_manifest_ref": {"$ref": "#/$defs/artifactRef"},
    "application_receipt_ref": {"$ref": "#/$defs/artifactRef"},
    "validator_engine": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"const": "phase7b_revision_package_validator"}, "version": {"const": "0.1.6"}}},
    "valid": {"const": true},
    "producer_state": {"const": "ready_for_independent_qc"},
    "issue_count": {"const": 0},
    "issues": {"type": "array", "maxItems": 0},
    "author_review_required": {"const": true},
    "module06_handoff_state": {"const": "blocked_pending_module06_integration_contract"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifactRef": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "artifact_version", "artifact_sha256"], "properties": {"artifact_id": {"$ref": "#/$defs/id"}, "artifact_version": {"$ref": "#/$defs/id"}, "artifact_sha256": {"$ref": "#/$defs/sha256"}}},
    "documentRef": {"type": "object", "additionalProperties": false, "required": ["manuscript_id", "artifact_id", "artifact_version", "artifact_sha256"], "properties": {"manuscript_id": {"$ref": "#/$defs/id"}, "artifact_id": {"$ref": "#/$defs/id"}, "artifact_version": {"$ref": "#/$defs/id"}, "artifact_sha256": {"$ref": "#/$defs/sha256"}}},
    "permissionRef": {"type": "object", "additionalProperties": false, "required": ["permission_id", "permission_version", "permission_sha256"], "properties": {"permission_id": {"$ref": "#/$defs/id"}, "permission_version": {"$ref": "#/$defs/id"}, "permission_sha256": {"$ref": "#/$defs/sha256"}}},
    "proposalRef": {"type": "object", "additionalProperties": false, "required": ["proposal_id", "proposal_version", "proposal_sha256"], "properties": {"proposal_id": {"$ref": "#/$defs/id"}, "proposal_version": {"$ref": "#/$defs/id"}, "proposal_sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
