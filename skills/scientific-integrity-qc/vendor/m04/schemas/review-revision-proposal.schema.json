{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-revision-proposal.schema.json",
  "title": "Phase 7B Review Revision Proposal 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "proposal_id", "proposal_sha256", "created_at", "created_by", "proposal_origin", "status", "document_type", "review_type", "source_artifact", "candidate_artifact", "permission_ref", "revision_mode", "operations", "unresolved_queries", "profile_alignment", "author_review_required"],
  "properties": {
    "schema_name": {"const": "review_revision_proposal"}, "schema_version": {"const": "0.1.0"},
    "proposal_id": {"$ref": "#/$defs/id"}, "proposal_sha256": {"$ref": "#/$defs/sha256"},
    "created_at": {"type": "string", "format": "date-time"}, "created_by": {"$ref": "#/$defs/id"},
    "proposal_origin": {"const": "model_proposed"}, "status": {"const": "machine_proposed"},
    "document_type": {"const": "review_article"}, "review_type": {"enum": ["narrative_review", "mini_review", "scoping_style_review", "systematic_style_draft"]},
    "source_artifact": {"$ref": "#/$defs/documentRef"}, "candidate_artifact": {"$ref": "#/$defs/candidateRef"},
    "permission_ref": {"$ref": "#/$defs/permissionRef"}, "revision_mode": {"enum": ["light", "medium", "deep"]},
    "operations": {"type": "array", "items": {"$ref": "#/$defs/operation"}, "minItems": 1, "uniqueItems": true},
    "unresolved_queries": {"type": "array", "items": {"$ref": "#/$defs/query"}, "uniqueItems": true},
    "profile_alignment": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/profile"}]},
    "author_review_required": {"const": true}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "idArray": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
    "documentRef": {"type": "object", "additionalProperties": false, "required": ["manuscript_id", "artifact_id", "artifact_version", "artifact_sha256"], "properties": {"manuscript_id": {"$ref": "#/$defs/id"}, "artifact_id": {"$ref": "#/$defs/id"}, "artifact_version": {"$ref": "#/$defs/id"}, "artifact_sha256": {"$ref": "#/$defs/sha256"}}},
    "candidateRef": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "artifact_version"], "properties": {"artifact_id": {"$ref": "#/$defs/id"}, "artifact_version": {"$ref": "#/$defs/id"}}},
    "permissionRef": {"type": "object", "additionalProperties": false, "required": ["permission_id", "permission_version", "permission_sha256"], "properties": {"permission_id": {"$ref": "#/$defs/id"}, "permission_version": {"$ref": "#/$defs/id"}, "permission_sha256": {"$ref": "#/$defs/sha256"}}},
    "locator": {"type": "object", "additionalProperties": false, "required": ["locator_type", "side", "artifact_id", "unit_id", "span_sha256"], "properties": {"locator_type": {"enum": ["structured_unit", "authorized_empty_draft_slot"]}, "side": {"enum": ["source", "candidate"]}, "artifact_id": {"$ref": "#/$defs/id"}, "unit_id": {"$ref": "#/$defs/id"}, "span_sha256": {"$ref": "#/$defs/sha256"}}},
    "expectedTarget": {"type": "object", "additionalProperties": false, "required": ["unit_id", "unit_sha256", "locator"], "properties": {"unit_id": {"$ref": "#/$defs/id"}, "unit_sha256": {"$ref": "#/$defs/sha256"}, "locator": {"$ref": "#/$defs/locator"}}},
    "draftSlot": {"type": "object", "additionalProperties": false, "required": ["slot_id", "slot_version", "placeholder_token", "placeholder_sha256", "outline_paragraph_id", "section_id", "locator"], "properties": {"slot_id": {"$ref": "#/$defs/id"}, "slot_version": {"$ref": "#/$defs/id"}, "placeholder_token": {"type": "string", "minLength": 1}, "placeholder_sha256": {"$ref": "#/$defs/sha256"}, "outline_paragraph_id": {"$ref": "#/$defs/id"}, "section_id": {"$ref": "#/$defs/id"}, "locator": {"$ref": "#/$defs/locator"}}},
    "closure": {"type": "object", "additionalProperties": false, "required": ["claim_ids", "citation_relation_ids", "source_ids", "extraction_record_ids", "conflict_ids", "limitation_ids", "gap_ids", "author_position_ids", "future_direction_ids"], "properties": {"claim_ids": {"$ref": "#/$defs/idArray"}, "citation_relation_ids": {"$ref": "#/$defs/idArray"}, "source_ids": {"$ref": "#/$defs/idArray"}, "extraction_record_ids": {"$ref": "#/$defs/idArray"}, "conflict_ids": {"$ref": "#/$defs/idArray"}, "limitation_ids": {"$ref": "#/$defs/idArray"}, "gap_ids": {"$ref": "#/$defs/idArray"}, "author_position_ids": {"$ref": "#/$defs/idArray"}, "future_direction_ids": {"$ref": "#/$defs/idArray"}}},
    "sentence": {"type": "object", "additionalProperties": false, "required": ["candidate_sentence_id", "source_sentence_ids", "authorized_draft_slot_ids", "text", "claim_ids", "citation_relation_ids"], "properties": {"candidate_sentence_id": {"$ref": "#/$defs/id"}, "source_sentence_ids": {"$ref": "#/$defs/idArray"}, "authorized_draft_slot_ids": {"$ref": "#/$defs/idArray"}, "text": {"type": "string"}, "claim_ids": {"$ref": "#/$defs/idArray"}, "citation_relation_ids": {"$ref": "#/$defs/idArray"}}},
    "replacement": {"type": "object", "additionalProperties": false, "required": ["candidate_unit_id", "source_unit_ids", "authorized_draft_slot_ids", "section_id", "section_ordinal", "paragraph_plan_id", "sentences", "claim_ids", "citation_relation_ids", "source_ids", "extraction_record_ids", "conflict_ids", "limitation_ids", "gap_ids", "author_position_ids", "future_direction_ids"], "properties": {"candidate_unit_id": {"$ref": "#/$defs/id"}, "source_unit_ids": {"$ref": "#/$defs/idArray"}, "authorized_draft_slot_ids": {"$ref": "#/$defs/idArray"}, "section_id": {"$ref": "#/$defs/id"}, "section_ordinal": {"type": "integer", "minimum": 1}, "paragraph_plan_id": {"$ref": "#/$defs/id"}, "sentences": {"type": "array", "items": {"$ref": "#/$defs/sentence"}, "minItems": 1}, "claim_ids": {"$ref": "#/$defs/idArray"}, "citation_relation_ids": {"$ref": "#/$defs/idArray"}, "source_ids": {"$ref": "#/$defs/idArray"}, "extraction_record_ids": {"$ref": "#/$defs/idArray"}, "conflict_ids": {"$ref": "#/$defs/idArray"}, "limitation_ids": {"$ref": "#/$defs/idArray"}, "gap_ids": {"$ref": "#/$defs/idArray"}, "author_position_ids": {"$ref": "#/$defs/idArray"}, "future_direction_ids": {"$ref": "#/$defs/idArray"}}},
    "operation": {"type": "object", "additionalProperties": false, "required": ["operation_id", "operation_order", "operation_type", "target_unit_ids", "target_section_id", "destination_section_id", "destination_ordinal", "expected_targets", "expected_slot", "replacement_units", "phase7a_closure", "affected_protected_anchor_ids", "permission_decision_id", "rationale", "risk_class", "author_review_required"], "properties": {"operation_id": {"$ref": "#/$defs/id"}, "operation_order": {"type": "integer", "minimum": 1}, "operation_type": {"enum": ["replace_unit_text", "paragraph_split", "paragraph_merge", "paragraph_move", "section_move", "theme_reorganization", "draft_authorized_unit"]}, "target_unit_ids": {"$ref": "#/$defs/idArray"}, "target_section_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]}, "destination_section_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]}, "destination_ordinal": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]}, "expected_targets": {"type": "array", "items": {"$ref": "#/$defs/expectedTarget"}, "uniqueItems": true}, "expected_slot": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/draftSlot"}]}, "replacement_units": {"type": "array", "items": {"$ref": "#/$defs/replacement"}, "uniqueItems": true}, "phase7a_closure": {"$ref": "#/$defs/closure"}, "affected_protected_anchor_ids": {"$ref": "#/$defs/idArray"}, "permission_decision_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]}, "rationale": {"type": "string", "minLength": 1}, "risk_class": {"enum": ["low", "moderate", "high"]}, "author_review_required": {"const": true}}},
    "query": {"type": "object", "additionalProperties": false, "required": ["query_id", "query_type", "question", "affected_unit_ids", "blocks_revision", "status"], "properties": {"query_id": {"$ref": "#/$defs/id"}, "query_type": {"enum": ["ambiguity", "missing_extraction", "insufficient_access", "source_conflict", "source_scope", "citation_support", "scientific_judgment", "author_judgment"]}, "question": {"type": "string", "minLength": 1}, "affected_unit_ids": {"$ref": "#/$defs/idArray"}, "blocks_revision": {"type": "boolean"}, "status": {"const": "unresolved"}}},
    "profile": {"type": "object", "additionalProperties": false, "required": ["profile_id", "profile_version", "profile_sha256", "document_type", "corpus_type", "review_state", "stale", "feature_id", "support_locator"], "properties": {"profile_id": {"$ref": "#/$defs/id"}, "profile_version": {"$ref": "#/$defs/id"}, "profile_sha256": {"$ref": "#/$defs/sha256"}, "document_type": {"enum": ["review_article", "original_article", "mixed", "uncertain"]}, "corpus_type": {"enum": ["review_only", "article_only", "mixed", "uncertain"]}, "review_state": {"enum": ["reviewed", "unreviewed"]}, "stale": {"type": "boolean"}, "feature_id": {"$ref": "#/$defs/id"}, "support_locator": {"$ref": "#/$defs/id"}}}
  }
}
