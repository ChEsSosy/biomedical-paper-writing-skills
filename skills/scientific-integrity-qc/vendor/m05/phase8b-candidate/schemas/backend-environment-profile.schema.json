{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "backend-environment-profile.schema.json", "type": "object",
  "required": ["schema_name", "schema_version", "profile_id", "profile_sha256", "backend", "executable_path", "executable_sha256", "python_version", "platform", "packages", "capabilities", "limitations", "probe"],
  "properties": {
    "schema_name": {"const": "backend_environment_profile"}, "schema_version": {"const": "0.1.0"},
    "profile_id": {"type": "string", "minLength": 1}, "profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "backend": {"const": "restricted_python"}, "executable_path": {"type": "string", "minLength": 1}, "executable_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "python_version": {"type": "string", "minLength": 1}, "platform": {"type": "string", "minLength": 1},
    "packages": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "version"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
    "capabilities": {"type": "object", "required": ["formats", "fonts", "operations"], "properties": {"formats": {"type": "array", "minItems": 4, "items": {"type": "string"}, "uniqueItems": true}, "fonts": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}, "operations": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}}, "additionalProperties": false},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "probe": {"type": "object", "required": ["script_version", "script_sha256", "command", "created_at", "result"], "properties": {"script_version": {"const": "0.1.0"}, "script_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "command": {"type": "array", "minItems": 2, "items": {"type": "string"}}, "created_at": {"type": "string", "format": "date-time"}, "result": {"const": "available"}}, "additionalProperties": false}
  }, "additionalProperties": false
}
