{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "bounded-program-plan.schema.json", "type": "object",
  "required": ["schema_name", "schema_version", "plan_id", "plan_sha256", "generator_id", "generator_version", "backend", "design_package_ref", "admission_receipt_ref", "input_bindings", "output_directory", "figure_id", "panel_order", "group_order", "palette", "operations", "outputs", "seed_policy"],
  "properties": {
    "schema_name": {"const": "bounded_program_plan"}, "schema_version": {"const": "0.1.0"}, "plan_id": {"type": "string", "minLength": 1}, "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generator_id": {"const": "phase8b-restricted-python-generator"}, "generator_version": {"const": "0.1.0"}, "backend": {"const": "restricted_python"},
    "design_package_ref": {"$ref": "#/$defs/hashRef"}, "admission_receipt_ref": {"$ref": "#/$defs/hashRef"},
    "input_bindings": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["trusted_input_id", "source_data_id", "path", "format", "sha256", "variables", "units"], "properties": {"trusted_input_id": {"type": "string", "minLength": 1}, "source_data_id": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "format": {"const": "csv"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "variables": {"type": "array", "minItems": 3, "items": {"type": "string"}, "uniqueItems": true}, "units": {"type": "object", "additionalProperties": {"type": "string"}}}, "additionalProperties": false}},
    "output_directory": {"type": "string", "minLength": 1}, "figure_id": {"type": "string", "minLength": 1}, "panel_order": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}, "group_order": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}, "palette": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}},
    "operations": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["operation_id", "operation", "figure_id", "panel_id", "recipe_id", "layer_id", "source_data_ids", "variable_bindings", "analysis_output_ids", "parameters"], "properties": {"operation_id": {"type": "string", "minLength": 1}, "operation": {"type": "string", "enum": ["draw_axes", "draw_raw_points", "draw_supplied_annotation", "draw_legend", "export_svg", "export_png", "export_plot_data", "export_session_metadata"]}, "figure_id": {"type": "string", "minLength": 1}, "panel_id": {"type": "string", "minLength": 1}, "recipe_id": {"type": "string", "minLength": 1}, "layer_id": {"type": "string", "minLength": 1}, "source_data_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}, "variable_bindings": {"type": "object", "required": ["x", "y", "color"], "properties": {"x": {"type": "string", "minLength": 1}, "y": {"type": "string", "minLength": 1}, "color": {"type": "string", "minLength": 1}}, "additionalProperties": false}, "analysis_output_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "parameters": {"type": "object", "additionalProperties": {"type": "string"}}}, "additionalProperties": false}},
    "outputs": {"type": "array", "minItems": 4, "items": {"type": "object", "required": ["role", "path", "format", "panel_ids"], "properties": {"role": {"type": "string", "enum": ["vector_prototype", "raster_prototype", "plotting_data", "session_metadata"]}, "path": {"type": "string", "minLength": 1}, "format": {"type": "string", "enum": ["svg", "png", "tsv", "json"]}, "panel_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}}, "additionalProperties": false}, "uniqueItems": true},
    "seed_policy": {"type": "object", "required": ["stochastic_operations", "seed"], "properties": {"stochastic_operations": {"const": false}, "seed": {"type": ["integer", "null"]}}, "additionalProperties": false}
  },
  "$defs": {"hashRef": {"type": "object", "required": ["id", "version", "sha256"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false}},
  "additionalProperties": false
}
