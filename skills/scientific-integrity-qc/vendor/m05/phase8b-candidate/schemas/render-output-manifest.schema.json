{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "render-output-manifest.schema.json", "type": "object",
  "required": ["schema_name", "schema_version", "render_manifest_id", "render_manifest_sha256", "created_at", "execution_ref", "design_package_ref", "admission_receipt_ref", "program_sha256", "input_bindings", "outputs", "metadata_check"],
  "properties": {
    "schema_name": {"const": "render_output_manifest"}, "schema_version": {"const": "0.1.0"}, "render_manifest_id": {"type": "string", "minLength": 1}, "render_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "created_at": {"type": "string", "format": "date-time"},
    "execution_ref": {"$ref": "#/$defs/hashRef"}, "design_package_ref": {"$ref": "#/$defs/hashRef"}, "admission_receipt_ref": {"$ref": "#/$defs/hashRef"}, "program_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_bindings": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["input_id", "sha256"], "properties": {"input_id": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false}},
    "outputs": {"type": "array", "minItems": 4, "items": {"type": "object", "required": ["role", "path", "format", "size", "sha256", "panel_ids", "metadata"], "properties": {"role": {"type": "string"}, "path": {"type": "string", "minLength": 1}, "format": {"type": "string", "enum": ["svg", "png", "tsv", "json"]}, "size": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "panel_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}, "metadata": {"type": "object", "additionalProperties": {}}}, "additionalProperties": false}},
    "metadata_check": {"type": "object", "required": ["status", "checked_domains", "limitations"], "properties": {"status": {"const": "passed"}, "checked_domains": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}, "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}}, "additionalProperties": false}
  },
  "$defs": {"hashRef": {"type": "object", "required": ["id", "version", "sha256"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false}},
  "additionalProperties": false
}
