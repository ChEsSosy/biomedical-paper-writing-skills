{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "prototype-execution-authorization.schema.json", "type": "object",
  "required": ["schema_name", "schema_version", "authorization_id", "authorization_sha256", "authorization_origin", "authorization_state", "authorized_at", "execution_package_hash", "program_sha256", "backend_profile_ref", "admission_receipt_ref", "input_bindings", "authorized_write_roots", "command", "parameters", "scope"],
  "properties": {
    "schema_name": {"const": "prototype_execution_authorization"}, "schema_version": {"const": "0.1.0"},
    "authorization_id": {"type": "string", "minLength": 1}, "authorization_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorization_origin": {"type": "string", "enum": ["caller", "authorized_orchestrator"]}, "authorization_state": {"const": "caller_accepted"}, "authorized_at": {"type": "string", "format": "date-time"},
    "execution_package_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "program_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "backend_profile_ref": {"$ref": "#/$defs/hashRef"}, "admission_receipt_ref": {"$ref": "#/$defs/hashRef"},
    "input_bindings": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["input_id", "path", "sha256"], "properties": {"input_id": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false}},
    "authorized_write_roots": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "command": {"type": "array", "minItems": 3, "items": {"type": "string"}}, "parameters": {"type": "object", "additionalProperties": {"type": "string"}},
    "scope": {"const": "single_synthetic_prototype_run"}
  },
  "$defs": {"hashRef": {"type": "object", "required": ["id", "version", "sha256"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false}},
  "additionalProperties": false
}
