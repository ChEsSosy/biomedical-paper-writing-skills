{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shared-artifact.schema.json",
  "title": "Biomedical Writing Shared Artifact Definitions 0.2.2",
  "$defs": {
    "artifactId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "sourceLocator": {
      "type": "object",
      "required": ["locator_type", "span_kind", "source_span_sha256"],
      "properties": {
        "locator_type": {
          "type": "string",
          "enum": ["line_char_range", "xml_path", "html_dom_path", "pdf_page_line_range"]
        },
        "span_kind": {"type": "string", "enum": ["heading", "paragraph", "section_anchor"]},
        "source_span_sha256": {"$ref": "#/$defs/sha256"},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "start_char": {"type": "integer", "minimum": 0},
        "end_char": {"type": "integer", "minimum": 0},
        "xml_path": {"type": "string", "minLength": 1},
        "dom_path": {"type": "string", "minLength": 1},
        "source_anchor_order": {"type": "integer", "minimum": 1},
        "start_column": {"type": "integer", "minimum": 0},
        "end_column": {"type": "integer", "minimum": 0},
        "page_start": {"type": "integer", "minimum": 1},
        "page_end": {"type": "integer", "minimum": 1},
        "extracted_start_line": {"type": "integer", "minimum": 1},
        "extracted_end_line": {"type": "integer", "minimum": 1}
      },
      "oneOf": [
        {
          "required": ["start_line", "end_line", "start_char", "end_char"],
          "properties": {"locator_type": {"const": "line_char_range"}}
        },
        {
          "required": ["xml_path"],
          "properties": {"locator_type": {"const": "xml_path"}}
        },
        {
          "required": [
            "dom_path", "source_anchor_order", "start_line", "end_line", "start_column", "end_column"
          ],
          "properties": {"locator_type": {"const": "html_dom_path"}}
        },
        {
          "required": ["page_start", "page_end", "extracted_start_line", "extracted_end_line"],
          "properties": {"locator_type": {"const": "pdf_page_line_range"}}
        }
      ],
      "x-source-locator-contract": true,
      "additionalProperties": false
    },
    "artifactStatus": {
      "type": "string",
      "enum": ["draft", "author_review_required", "author_approved", "superseded"]
    },
    "timestamp": {"type": "string", "format": "date-time"},
    "createdBy": {"type": "string", "minLength": 1},
    "sourceFile": {
      "type": "object",
      "required": ["path", "role"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "role": {
          "type": "string",
          "enum": [
            "corpus_document", "metadata", "derived_artifact", "gold_standard",
            "configuration", "other"
          ]
        },
        "document_id": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "locator": {"type": "string"},
        "access_status": {
          "type": "string",
          "enum": ["author_owned", "open_access", "licensed_local_use", "permission_confirmed", "unknown"]
        }
      },
      "additionalProperties": false
    },
    "warning": {
      "type": "object",
      "required": ["code", "message", "severity"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "severity": {"type": "string", "enum": ["blocker", "error", "warning", "info"]},
        "locator": {"type": "string"}
      },
      "additionalProperties": false
    },
    "sourceArtifactIds": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifactId"},
      "uniqueItems": true
    },
    "sourceFiles": {
      "type": "array",
      "items": {"$ref": "#/$defs/sourceFile"}
    },
    "warnings": {
      "type": "array",
      "items": {"$ref": "#/$defs/warning"}
    },
    "numericDistribution": {
      "type": "object",
      "required": ["count", "mean", "median", "p25", "p75", "minimum", "maximum"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "mean": {"type": "number"},
        "median": {"type": "number"},
        "p25": {"type": "number"},
        "p75": {"type": "number"},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"}
      },
      "additionalProperties": false
    },
    "bootstrapInterval": {
      "type": "object",
      "required": ["low", "high", "method"],
      "properties": {
        "low": {"type": "number"},
        "high": {"type": "number"},
        "method": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "methodValue": {
      "type": "object",
      "required": ["method", "value"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "value": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "stratumCoverage": {
      "type": "object",
      "required": [
        "available_document_count", "represented_stratum_count", "total_stratum_count", "coverage_rate",
        "contributor_count_by_stratum", "minimum_contributor_count", "maximum_contributor_share",
        "effective_stratum_count"
      ],
      "properties": {
        "available_document_count": {"type": "integer", "minimum": 0},
        "represented_stratum_count": {"type": "integer", "minimum": 0},
        "total_stratum_count": {"type": "integer", "minimum": 0},
        "coverage_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "contributor_count_by_stratum": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 1}
        },
        "minimum_contributor_count": {"type": "integer", "minimum": 0},
        "maximum_contributor_share": {"type": "number", "minimum": 0, "maximum": 1},
        "effective_stratum_count": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "featureSupport": {
      "type": "object",
      "required": [
        "feature_id", "document_count", "document_coverage", "value_summary", "bootstrap_95",
        "between_document_dispersion", "leave_one_document_out_median_sensitivity", "parser_support", "stratum_coverage"
      ],
      "properties": {
        "feature_id": {"type": "string", "minLength": 1},
        "document_count": {"type": "integer", "minimum": 1},
        "document_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "value_summary": {"$ref": "#/$defs/numericDistribution"},
        "bootstrap_95": {"$ref": "#/$defs/bootstrapInterval"},
        "between_document_dispersion": {"$ref": "#/$defs/methodValue"},
        "leave_one_document_out_median_sensitivity": {"$ref": "#/$defs/methodValue"},
        "parser_support": {
          "type": "object",
          "required": ["format_prior", "observed_parse_qc"],
          "properties": {
            "format_prior": {"$ref": "#/$defs/numericDistribution"},
            "observed_parse_qc": {
              "type": "object",
              "required": ["heading_recognition_rate", "fragment_paragraph_rate", "reference_contamination_rate"],
              "properties": {
                "heading_recognition_rate": {"$ref": "#/$defs/numericDistribution"},
                "fragment_paragraph_rate": {"$ref": "#/$defs/numericDistribution"},
                "reference_contamination_rate": {"$ref": "#/$defs/numericDistribution"}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "stratum_coverage": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/stratumCoverage"}
        }
      },
      "additionalProperties": false
    },
    "artifactEnvelope": {
      "type": "object",
      "required": [
        "schema_name", "schema_version", "artifact_id", "created_at", "created_by",
        "source_artifact_ids", "source_files", "status", "warnings"
      ],
      "properties": {
        "schema_name": {"type": "string", "minLength": 1},
        "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "artifact_id": {"$ref": "#/$defs/artifactId"},
        "created_at": {"$ref": "#/$defs/timestamp"},
        "created_by": {"$ref": "#/$defs/createdBy"},
        "source_artifact_ids": {"$ref": "#/$defs/sourceArtifactIds"},
        "source_files": {"$ref": "#/$defs/sourceFiles"},
        "status": {"$ref": "#/$defs/artifactStatus"},
        "warnings": {"$ref": "#/$defs/warnings"}
      }
    }
  },
  "$ref": "#/$defs/artifactEnvelope"
}
