{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gold-standard.schema.json",
  "title": "Manual Observable-Structure Gold Standard 0.2.2",
  "type": "object",
  "required": [
    "schema_name", "schema_version", "artifact_id", "created_at", "created_by", "source_artifact_ids",
    "source_files", "status", "warnings", "annotation_scope", "documents"
  ],
  "properties": {
    "schema_name": {"const": "observable_structure_gold_standard"},
    "schema_version": {"const": "0.2.2"},
    "artifact_id": {"$ref": "../shared-core/schemas/shared-artifact.schema.json#/$defs/artifactId"},
    "created_at": {"$ref": "../shared-core/schemas/shared-artifact.schema.json#/$defs/timestamp"},
    "created_by": {"$ref": "../shared-core/schemas/shared-artifact.schema.json#/$defs/createdBy"},
    "source_artifact_ids": {"$ref": "../shared-core/schemas/shared-artifact.schema.json#/$defs/sourceArtifactIds"},
    "source_files": {"$ref": "../shared-core/schemas/shared-artifact.schema.json#/$defs/sourceFiles"},
    "status": {"const": "author_approved"},
    "warnings": {"$ref": "../shared-core/schemas/shared-artifact.schema.json#/$defs/warnings"},
    "annotation_scope": {"const": "observable_structure_only_no_semantic_roles"},
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["document_id", "source_sha256", "sections", "paragraphs", "figure_references"],
        "properties": {
          "document_id": {"type": "string", "minLength": 1},
          "source_sha256": {"$ref": "../shared-core/schemas/shared-artifact.schema.json#/$defs/sha256"},
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "gold_section_id", "parent_gold_section_id", "source_heading", "source_heading_level",
                "canonical_section", "source_locator"
              ],
              "properties": {
                "gold_section_id": {"type": "string", "minLength": 1},
                "parent_gold_section_id": {"type": ["string", "null"]},
                "source_heading": {"type": "string"},
                "source_heading_level": {"type": "integer", "minimum": 0},
                "canonical_section": {"type": "string", "minLength": 1},
                "source_locator": {"$ref": "../shared-core/schemas/shared-artifact.schema.json#/$defs/sourceLocator"}
              },
              "additionalProperties": false
            }
          },
          "paragraphs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["gold_paragraph_id", "gold_section_id", "source_locator"],
              "properties": {
                "gold_paragraph_id": {"type": "string", "minLength": 1},
                "gold_section_id": {"type": "string", "minLength": 1},
                "source_locator": {"$ref": "../shared-core/schemas/shared-artifact.schema.json#/$defs/sourceLocator"}
              },
              "additionalProperties": false
            }
          },
          "figure_references": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["gold_reference_id", "gold_paragraph_id", "figure_id", "panel_tokens"],
              "properties": {
                "gold_reference_id": {"type": "string", "minLength": 1},
                "gold_paragraph_id": {"type": "string", "minLength": 1},
                "figure_id": {"type": "string", "minLength": 1},
                "panel_tokens": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
